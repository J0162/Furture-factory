   <node f="8000000442" dt="2"><name>sendtoport</name><data>Object item = param(1);
Object current = ownerobject(c);
/**Round Robin if Available*/
/**Send flowItem to the next available output port in round robin fashion 
(choosing next available output port in numerical succession).*/
treenode curlabel = current.labels.assert("f_cursendport", 1);

if (getoutput(current) == 0 &amp;&amp; item.rank == 1)  
	current.f_cursendport = 1; //reset round robin counter if first part

double firstoutport = curlabel.value;
int forcestop = 0;

while (!forcestop &amp;&amp; !opavailable(current, curlabel.value)) {
	curlabel.value += 1;
    if (curlabel.value &gt; current.outObjects.length)
        current.f_cursendport = 1;
    if (curlabel.value == firstoutport)  forcestop = 1;
}  
if (forcestop) return 0; // return First Available if none are available

double returnvalue = curlabel.value;
curlabel.value += 1;
if (curlabel.value &gt; current.outObjects.length)
    current.f_cursendport = 1;

return  returnvalue;</data></node>
