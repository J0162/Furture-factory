      <node f="442" dt="2"><name>OnDraw</name><data>if (switch_hideshape(c))
	return 0;
fglRotate(-90, 1, 0, 0);
fglDisable(GL_LIGHTING);
fglDisable(GL_TEXTURE_2D);
treenode view = tonode(eventdata);
treenode meshNode = getvarnode(c, "mesh");
meshdraw(meshNode, GL_LINES, 0, 24);
if (getpickingmode(view)) {
	meshdraw(meshNode, GL_TRIANGLES, 24, 36);
}
treenode hoverObj = getpickingdrawfocus(view, PICK_OBJECT, -1);
treenode pickedObj = getpickingdrawfocus(view, PICK_OBJECT, 0);
treenode selObj = selectedobject(view);
if (hoverObj != c &amp;&amp; pickedObj != c &amp;&amp; selObj != c){
	glLineWidth(3);
	meshdraw(meshNode, GL_LINES, 0, 24);
	glLineWidth(1);
}
fglEnable(GL_LIGHTING);
fglEnable(GL_TEXTURE_2D);
</data></node>
